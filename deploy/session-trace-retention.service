[Unit]
Description=Delete session trace rows older than 30 days
[Service]
Type=oneshot
ExecStart=/bin/bash -c '. %h/.config/dev-secrets.env; if [ -r %h/.config/extra-secrets.env ]; then . %h/.config/extra-secrets.env; fi; exec psql "$ARTIFACTS_DATABASE_URL" -X -qAt -v ON_ERROR_STOP=1 -c "SELECT session_trace_retention(30)"'
TimeoutStartSec=30min
